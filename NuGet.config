<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="phase0-local" value=".phase0/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="phase0-local">
      <package pattern="KeelMatrix.Phase0.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="KeelMatrix.Telemetry" />
      <package pattern="Microsoft.SourceLink.GitHub" />
      <package pattern="Microsoft.SourceLink.Common" />
      <package pattern="Microsoft.WindowsDesktop.App.Ref" />
    </packageSource>
  </packageSourceMapping>
</configuration>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>KeelMatrix.Phase0.ContentInjection</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageDescription>Phase 0 content files fixture.</PackageDescription>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="content/contentFiles/cs/any/Active.cs" Pack="true" PackagePath="contentFiles/cs/any/Active.cs" />
    <None Include="content/contentFiles/cs/net9.0/Inactive.cs" Pack="true" PackagePath="contentFiles/cs/net9.0/Inactive.cs" />
  </ItemGroup>
</Project>

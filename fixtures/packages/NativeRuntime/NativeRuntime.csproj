<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>KeelMatrix.Phase0.NativeRuntime</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageDescription>Phase 0 native RID fixture.</PackageDescription>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="content/runtimes/win-x64/native/active.dll" Pack="true" PackagePath="runtimes/win-x64/native/active.dll" />
    <None Include="content/runtimes/linux-x64/native/inactive.so" Pack="true" PackagePath="runtimes/linux-x64/native/inactive.so" />
  </ItemGroup>
</Project>
